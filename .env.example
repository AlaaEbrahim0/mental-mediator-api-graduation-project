# Mental Mediator local development
#
# Copy this file to `.env` and fill in your own values. The `.env` file is
# gitignored and must never be committed.
#
# Variables used by docker-compose.yml (Docker Compose v2 interpolates them):
#
# Database
# CONNECTIONSTRINGS_CONSTR=Server=localhost,1433;Database=MentalMediator;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;
# SA_PASSWORD=YourStrongPassword123!
#
# JWT (min 32 chars for this project)
# JWT_SETTINGS_KEY=your-jwt-secret-key-here
#
# External services (set empty to disable)
# GOOGLE_AUTHENTICATION_ID=
# GOOGLE_AUTHENTICATION_SECRET=
# NEWS_API_KEY=
#
# (Keep the existing backend-specific vars in API/.env — they are not needed
# for Docker Compose; the compose file above maps to these local-only values.)
