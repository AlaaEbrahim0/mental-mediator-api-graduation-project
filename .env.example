# Mental Mediator API — local development environment template
#
# Copy this file to `.env` and fill in your own values. `.env` is gitignored and
# must never be committed.
#
# Two consumers read this file, with different naming rules:
#
#   1. The API process. `dotenv.net` loads `.env` into process environment
#      variables, and ASP.NET configuration maps `Section__Key` onto
#      appsettings.json. Those names are case-sensitive in effect and must use
#      the double-underscore form (for example `MailSettings__Host`).
#   2. docker-compose.yml, which interpolates the ${UPPER_SNAKE} variables below.
#
# Anything absent falls back to appsettings.Development.json / the code default.

# ─── Database ────────────────────────────────────────────────────────────────
# Used directly by the API when running without Docker.
ConnectionStrings__constr=Server=localhost,1433;Database=MentalMediator;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;
# Interpolated into the `api` and `db` containers by docker-compose.
CONNECTIONSTRINGS_CONSTR=Server=localhost,1433;Database=MentalMediator;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;
SA_PASSWORD=YourStrongPassword123!

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Signing key, minimum 32 characters. Never reuse a production key locally.
JwtSettings__Key=dev-key-min-32-chars-long-for-local-dev
JWT_SETTINGS_KEY=dev-key-min-32-chars-long-for-local-dev
# Token lifetime in minutes.
JwtSettings__Duration=30

# ─── Image storage (required for any photo upload) ───────────────────────────
# Cloudinary is the only IStorageService implementation. Without a valid URL the
# API still starts, and every upload endpoint returns a controlled 503
# (ExternalServices.StorageServiceUnavailable) instead of writing a broken URL.
# Format: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
# Leave empty to work on the portals without touching uploads.
CLOUDINARY_URL=

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# Gmail requires an application-specific password when 2-step verification is on;
# a normal account password is rejected with an authentication error.
MailSettings__Host=smtp.gmail.com
MailSettings__Port=587
MailSettings__Username=
MailSettings__Password=
# Optional display name shown beside the sender address. Not a secret.
MailSettings__SenderName=Mental Mediator

# ─── Google sign-in ──────────────────────────────────────────────────────────
# Client credentials for the OAuth consent screen. The authorized redirect URI
# in Google Cloud Console must include
# https://<api-host>/api/auth/external-login-callback for the flow to complete.
GoogleAuthentication__Id=
GoogleAuthentication__Secret=

# ─── Frontend origins ────────────────────────────────────────────────────────
# ClientUI is the patient portal, DoctorUI the doctor portal. They are used for
# the Google callback redirect and for the password-reset link, which is chosen
# per account role. These are public URLs, not secrets.
ClientUI=http://localhost:3000
DoctorUI=http://localhost:3000

# ─── Optional external services ──────────────────────────────────────────────
# News feed. Empty ApiKey disables the news feature.
NewsApi__Address=https://newsapi.org/v2/
NewsApi__ApiKey=
# Sentiment / hate-speech detection service.
MLServerAddress=

# ─── Seed doctor account (development only) ──────────────────────────────────
# Used to create a known doctor login on a fresh database. Local values only —
# never reuse real credentials here.
DoctorSeed__Email=
DoctorSeed__Password=
DoctorSeed__FirstName=
DoctorSeed__LastName=
DoctorSeed__BirthDate=1990-01-01
DoctorSeed__Gender=Male
DoctorSeed__City=
DoctorSeed__Specialization=
